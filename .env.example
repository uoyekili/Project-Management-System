# Copy to .env before running docker-compose.prod.yml (cp .env.example .env).
TZ=Asia/Ho_Chi_Minh

# MySQL
MYSQL_ROOT_PASSWORD=taskflow-root-password
MYSQL_DATABASE=taskflow
MYSQL_USER=taskflow
MYSQL_PASSWORD=taskflow-db-password

# Ports (optional, defaults shown)
FRONTEND_HOST_PORT=3000
BACKEND_HOST_PORT=8000
FRONTEND_PORT=3000
BACKEND_PORT=8000

# Backend
BACKEND_WORKERS=2
